# HTTPS automático con Let's Encrypt para el dominio del servidor (DOMINIO en el .env)
{$DOMINIO} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Webhook de WhatsApp (Meta): entregado/leído y respuestas de los pacientes
	handle /webhook/whatsapp {
		reverse_proxy notificaciones:8093
	}
	handle {
		reverse_proxy frontend:80
	}
}
