# Copia este archivo como .env para cambiar valores por defecto
DB_PASSWORD=clinica
DB_ROOT_PASSWORD=root-clinica
JWT_SECRET=pon-aqui-un-secreto-largo-y-unico
# true: muestra el código de recuperación en pantalla (solo para demostración)
APP_DEMO_MODE=true
# true: crea pacientes y citas de ejemplo la primera vez
APP_SEED_DEMO=true
# SMTP opcional para enviar el código de recuperación por correo
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
# Datos del emisor que salen en los comprobantes
EMPRESA_RUC=10102984841
EMPRESA_RAZON_SOCIAL=CLÍNICA DENTAL CÁRDENAS
# soap: envía a la API simulada de SUNAT (servicio sunat-sim) · interno: validación dentro del backend
SUNAT_MODE=soap
# Usuario SOL secundario (se envía como RUC + usuario) y su clave
SUNAT_USUARIO=MODDATOS
SUNAT_CLAVE=MODDATOS
