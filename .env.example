# Copia este archivo como .env para cambiar valores por defecto
DB_PASSWORD=clinica
DB_ROOT_PASSWORD=root-clinica
JWT_SECRET=pon-aqui-un-secreto-largo-y-unico
# true: muestra el código de recuperación en pantalla (solo para demostración)
APP_DEMO_MODE=true
# true: crea pacientes y citas de ejemplo la primera vez
APP_SEED_DEMO=true
# SMTP opcional para enviar el código de recuperación por correo
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
# Datos del emisor que salen en los comprobantes
EMPRESA_RUC=10102984841
EMPRESA_RAZON_SOCIAL=CLÍNICA DENTAL CÁRDENAS
# soap: envía a la API simulada de SUNAT (servicio sunat-sim) · interno: validación dentro del backend
SUNAT_MODE=soap
# Usuario SOL secundario (se envía como RUC + usuario) y su clave
SUNAT_USUARIO=MODDATOS
SUNAT_CLAVE=MODDATOS

# ---------------------------------------------------------------------------------------------
# MENSAJES REALES (microservicio de notificaciones). Si se dejan vacíos, el canal queda en modo de prueba.
# Por seguridad solo se envía de verdad a los números/correos permitidos. ENVIAR_A_TODOS=true para producción.
# ---------------------------------------------------------------------------------------------
# WhatsApp Cloud API de Meta (developers.facebook.com → tu app → WhatsApp → Configuración de la API)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Plantilla aprobada con una variable {{1}} (recomendado para recordatorios). Vacío = texto libre (solo ventana de 24 h)
WA_PLANTILLA=
WA_PLANTILLA_IDIOMA=es
# Celulares que reciben mensajes reales (separados por coma), p. ej. 987654321,912345678
WA_NUMEROS_PERMITIDOS=

# Correo por SMTP. Gmail: smtp.gmail.com, puerto 587, y una "contraseña de aplicación" de 16 letras
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
CORREOS_PERMITIDOS=

ENVIAR_A_TODOS=false
