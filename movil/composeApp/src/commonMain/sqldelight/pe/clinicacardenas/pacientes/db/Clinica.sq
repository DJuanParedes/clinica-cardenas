-- Persistencia local multiplataforma (SQLDelight). Es la fuente única de verdad de la app:
-- la pantalla lee de aquí con consultas observables y nunca espera a la red para dibujar.

CREATE TABLE ajuste (
    clave TEXT NOT NULL PRIMARY KEY,
    valor TEXT NOT NULL
);

-- Citas del paciente. id < 0 = reserva creada sin conexión (identificador provisional que el servicio nunca emite).
-- pendiente = 1: hay un cambio local que todavía no llegó al servicio.
CREATE TABLE cita (
    id INTEGER NOT NULL PRIMARY KEY,
    inicio TEXT NOT NULL,
    fin TEXT NOT NULL,
    duracion INTEGER NOT NULL,
    motivo TEXT NOT NULL,
    estado TEXT NOT NULL,
    odontologo TEXT NOT NULL,
    especialidad TEXT NOT NULL,
    color TEXT NOT NULL,
    puede_confirmar INTEGER NOT NULL,
    proxima INTEGER NOT NULL,
    pendiente INTEGER NOT NULL DEFAULT 0,
    error_sync TEXT,
    puede_reprogramar INTEGER NOT NULL DEFAULT 0,
    puede_cancelar INTEGER NOT NULL DEFAULT 0,
    odontologo_id INTEGER
);

-- Cola de escrituras pendientes (offline-first). Se envían en orden de creación antes de bajar datos.
CREATE TABLE operacion_pendiente (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tipo TEXT NOT NULL,
    cita_id INTEGER NOT NULL,
    datos TEXT NOT NULL,
    clave TEXT NOT NULL,
    estado TEXT NOT NULL DEFAULT 'PENDIENTE',
    intentos INTEGER NOT NULL DEFAULT 0,
    proximo_intento INTEGER NOT NULL DEFAULT 0,
    error TEXT,
    creada INTEGER NOT NULL
);

obtenerAjuste:
SELECT valor FROM ajuste WHERE clave = ?;

guardarAjuste:
INSERT OR REPLACE INTO ajuste(clave, valor) VALUES (?, ?);

borrarAjuste:
DELETE FROM ajuste WHERE clave = ?;

citas:
SELECT * FROM cita ORDER BY inicio;

insertarCita:
INSERT OR REPLACE INTO cita VALUES ?;

borrarCitas:
DELETE FROM cita;

borrarCitasSincronizadas:
DELETE FROM cita WHERE pendiente = 0;

idsPendientes:
SELECT id FROM cita WHERE pendiente = 1;

marcarCitaPendiente:
UPDATE cita SET estado = ?, puede_confirmar = 0, pendiente = 1, error_sync = NULL WHERE id = ?;

marcarErrorCita:
UPDATE cita SET error_sync = ? WHERE id = ?;

limpiarPendienteCita:
UPDATE cita SET pendiente = 0, error_sync = NULL WHERE id = ?;

reemplazarIdCita:
UPDATE cita SET id = ?, pendiente = 0, error_sync = NULL WHERE id = ?;

borrarCita:
DELETE FROM cita WHERE id = ?;

operaciones:
SELECT * FROM operacion_pendiente ORDER BY id;

operacionesListas:
SELECT * FROM operacion_pendiente WHERE estado = 'PENDIENTE' AND proximo_intento <= ? ORDER BY id;

encolarOperacion:
INSERT INTO operacion_pendiente(tipo, cita_id, datos, clave, creada) VALUES (?, ?, ?, ?, ?);

borrarOperacion:
DELETE FROM operacion_pendiente WHERE id = ?;

reprogramarOperacion:
UPDATE operacion_pendiente SET intentos = ?, proximo_intento = ?, error = ? WHERE id = ?;

fallarOperacion:
UPDATE operacion_pendiente SET estado = 'FALLIDA', intentos = ?, error = ? WHERE id = ?;

reactivarOperacion:
UPDATE operacion_pendiente SET estado = 'PENDIENTE', intentos = 0, proximo_intento = 0, error = NULL WHERE id = ?;

operacion:
SELECT * FROM operacion_pendiente WHERE id = ?;

borrarOperaciones:
DELETE FROM operacion_pendiente;
