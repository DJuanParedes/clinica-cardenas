-- Versión 1 → 2 (app 2.5.0): offline-first con cola de escrituras pendientes.
ALTER TABLE cita ADD COLUMN pendiente INTEGER NOT NULL DEFAULT 0;
ALTER TABLE cita ADD COLUMN error_sync TEXT;
ALTER TABLE cita ADD COLUMN puede_reprogramar INTEGER NOT NULL DEFAULT 0;
ALTER TABLE cita ADD COLUMN puede_cancelar INTEGER NOT NULL DEFAULT 0;
ALTER TABLE cita ADD COLUMN odontologo_id INTEGER;

CREATE TABLE operacion_pendiente (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tipo TEXT NOT NULL,
    cita_id INTEGER NOT NULL,
    datos TEXT NOT NULL,
    clave TEXT NOT NULL,
    estado TEXT NOT NULL DEFAULT 'PENDIENTE',
    intentos INTEGER NOT NULL DEFAULT 0,
    proximo_intento INTEGER NOT NULL DEFAULT 0,
    error TEXT,
    creada INTEGER NOT NULL
);
